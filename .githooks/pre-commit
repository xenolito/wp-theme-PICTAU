#!/bin/sh
# Antes de cada commit que toque CSS/JS fuente (tailwind/, javascript/,
# postcss.config.js), regenera el build de produccion (minificado) y el
# critical CSS (above-the-fold inline), y los incluye en el propio commit.
#
# Sin esto, es facil quedarte trabajando con "npm run watch" (sin
# minificar, con sourcemaps) y que el hook post-commit despliegue ese
# build de desarrollo a produccion sin darte cuenta. El critical CSS se
# regenera aqui mismo porque un cambio visual above-the-fold (hero, header,
# nav) puede desincronizar theme/critical/*.css del diseno real igual que
# el propio style.css.

changed_source=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(tailwind/|javascript/|postcss\.config\.js)')

if [ -n "$changed_source" ]; then
  echo "pre-commit: CSS/JS fuente modificado, regenerando build de produccion..."

  if ! npm run production; then
    echo "pre-commit: 'npm run production' fallo. Commit abortado." >&2
    exit 1
  fi

  # Apagado a nivel de proyecto: si existe .critical-css-disabled en la raiz
  # del tema, este proyecto no usa critical CSS y nos saltamos por completo
  # la comprobacion del sitio y la generacion (ver generate-critical-css.js,
  # que respeta el mismo marcador para "npm run bundle").
  if [ -f .critical-css-disabled ]; then
    echo "pre-commit: critical CSS desactivado para este proyecto (.critical-css-disabled existe), omitiendo."
  else
    # Comprobacion rapida (<1s) del sitio local ANTES de gastar tiempo en
    # Puppeteer: si esta en modo mantenimiento o caido, "npm run critical"
    # fallaria igualmente mas tarde, pero asi el aviso llega al instante y
    # con un banner imposible de pasar por alto (node_scripts/lib/site-preflight.js).
    if ! node node_scripts/check-site-reachable.js; then
      echo "pre-commit: sitio local no accesible. Commit abortado." >&2
      exit 1
    fi

    echo "pre-commit: regenerando critical CSS (theme/critical/*.css)..."

    if ! npm run critical; then
      echo "pre-commit: 'npm run critical' fallo. Commit abortado." >&2
      exit 1
    fi
  fi

  git add theme/
fi

# El post-commit despliega solo el arbol de theme/ (ver .githooks/post-commit),
# asi que README.md (en la raiz del repo) nunca llega al repo de deploy salvo
# que tambien exista una copia dentro de theme/. La mantenemos sincronizada
# aqui cada vez que README.md cambia.
changed_readme=$(git diff --cached --name-only --diff-filter=ACMR -- README.md)

if [ -n "$changed_readme" ]; then
  cp README.md theme/README.md
  git add theme/README.md
fi

exit 0
